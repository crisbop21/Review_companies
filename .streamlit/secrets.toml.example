# Streamlit secrets template for the Earnings Podcast Agent.
#
# Usage (local):
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   # fill in the values below
#   streamlit run streamlit/app.py
#
# Usage (Streamlit Community Cloud):
#   Paste the contents of your real secrets.toml into the Secrets tab
#   for the deployed app. Do NOT commit the real file.
#
# Keys already present in os.environ (or a local .env loaded by
# python-dotenv) take precedence. Delete any key below to fall back to
# the config default.

# --- Required ---
ANTHROPIC_API_KEY = "sk-ant-..."
ELEVENLABS_API_KEY = "..."
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."

# --- Model overrides (optional) ---
# SONNET_MODEL = "claude-sonnet-4-6"
# OPUS_MODEL = "claude-opus-4-6"

# --- ElevenLabs (optional) ---
# ELEVENLABS_MODEL = "eleven_multilingual_v2"
# DEFAULT_HOST_VOICE = "Rachel"
# DEFAULT_BULL_VOICE = "Antoni"
# DEFAULT_BEAR_VOICE = "Clyde"
# HOST_VOICE_ES = "..."
# BULL_VOICE_ES = "..."
# BEAR_VOICE_ES = "..."

# --- RAG (only when enabled) ---
# EMBEDDING_MODEL = "text-embedding-3-small"
# OPENAI_API_KEY = "sk-..."
